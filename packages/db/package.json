{
  "name": "@webops-wizard/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly",
    "db:generate": "prisma generate",
    "db:migration:check": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/webops_wizard} prisma format --check && DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/webops_wizard} prisma validate",
    "db:schema:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/webops_wizard} prisma validate",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0"
  },
  "devDependencies": {
    "prisma": "^6.6.0"
  }
}
