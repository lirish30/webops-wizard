generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                        @id @default(uuid())
  email                      String                        @unique @db.Citext
  passwordHash               String?                       @map("password_hash")
  fullName                   String                        @map("full_name")
  authProvider               AuthProvider                  @default(local) @map("auth_provider")
  status                     UserStatus                    @default(active)
  lastLoginAt                DateTime?                     @map("last_login_at") @db.Timestamptz(6)
  createdAt                  DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships                WorkspaceMembership[]
  ownedWorkspaces            Workspace[]                   @relation("WorkspaceOwner")
  authSessions               AuthSession[]
  passwordResetTokens        PasswordResetToken[]
  sentWorkspaceInvites       WorkspaceInvite[]             @relation("WorkspaceInviteInviter")
  acceptedWorkspaceInvites   WorkspaceInvite[]             @relation("WorkspaceInviteAcceptedUser")
  externalIdentityLinks      ExternalIdentityLink[]
  createdIntegrationLinks    IntegrationConnection[]       @relation("IntegrationCreatedBy")
  createdComparabilityWindow ComparabilityWindow[]
  createdAnnotations         MeasurementAnnotation[]
  pageOwnership              CanonicalPage[]               @relation("CanonicalPageOwner")
  conversionVersionAuthors   ConversionDefinitionVersion[]
  createdReleaseEvents       ReleaseAnnotation[]           @relation("ReleaseCreatedBy")
  experimentOwnership        Experiment[]                  @relation("ExperimentOwner")
  recommendationOwnership    Recommendation[]              @relation("RecommendationOwner")
  generatedReports           Report[]                      @relation("ReportGeneratedBy")
  approvedReports            Report[]                      @relation("ReportApprovedBy")
  authoredAuditEvents        AuditLogEvent[]               @relation("AuditActorUser")

  @@map("users")
}

model Workspace {
  id           String                  @id @default(uuid())
  name         String
  slug         String                  @unique
  ownerUserId  String                  @map("owner_user_id")
  planTier     WorkspacePlanTier       @default(starter) @map("plan_tier")
  region       String                  @default("us")
  status       WorkspaceStatus         @default(active)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner        User                    @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  memberships  WorkspaceMembership[]
  invites      WorkspaceInvite[]
  properties   Property[]
  integrations IntegrationConnection[]
  connectorCredentials ConnectorCredential[]
  connectorSyncRuns    ConnectorSyncRun[]
  searchConsoleSites   SearchConsoleSite[]
  auditEvents  AuditLogEvent[]

  @@index([ownerUserId])
  @@map("workspaces")
}

model WorkspaceMembership {
  id           String         @id @default(uuid())
  workspaceId  String         @map("workspace_id")
  userId       String         @map("user_id")
  role         MembershipRole
  scopeJson    Json?          @map("scope_json")
  lastActiveAt DateTime?      @map("last_active_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@map("workspace_memberships")
}

model AuthSession {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  refreshTokenHash  String    @map("refresh_token_hash")
  activeWorkspaceId String?   @map("active_workspace_id")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([refreshTokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@index([userId, consumedAt, expiresAt])
  @@map("password_reset_tokens")
}

model WorkspaceInvite {
  id             String         @id @default(uuid())
  workspaceId    String         @map("workspace_id")
  email          String         @db.Citext
  role           MembershipRole
  inviterUserId  String         @map("inviter_user_id")
  tokenHash      String         @map("token_hash")
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?      @map("accepted_at") @db.Timestamptz(6)
  acceptedUserId String?        @map("accepted_user_id")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter        User           @relation("WorkspaceInviteInviter", fields: [inviterUserId], references: [id])
  acceptedUser   User?          @relation("WorkspaceInviteAcceptedUser", fields: [acceptedUserId], references: [id])

  @@unique([tokenHash])
  @@index([workspaceId, email])
  @@index([expiresAt])
  @@index([workspaceId, acceptedAt, expiresAt])
  @@map("workspace_invites")
}

model IdentityProvider {
  id          String                 @id @default(uuid())
  type        IdentityProviderType   @unique
  displayName String                 @map("display_name")
  status      IdentityProviderStatus @default(coming_soon)
  configJson  Json?                  @map("config_json")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  links       ExternalIdentityLink[]

  @@map("identity_providers")
}

model ExternalIdentityLink {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  providerId      String           @map("provider_id")
  providerSubject String           @map("provider_subject")
  emailSnapshot   String           @map("email_snapshot") @db.Citext
  lastLoginAt     DateTime?        @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, providerSubject])
  @@index([userId])
  @@map("external_identity_links")
}

model Property {
  id                      String                  @id @default(uuid())
  workspaceId             String                  @map("workspace_id")
  name                    String
  primaryDomain           String                  @map("primary_domain")
  environment             PropertyEnvironment     @default(prod)
  businessModel           PropertyBusinessModel   @default(other) @map("business_model")
  analyticsSourceOfTruth  String?                 @map("analytics_source_of_truth")
  conversionSourceOfTruth String?                 @map("conversion_source_of_truth")
  crmSourceOfTruth        String?                 @map("crm_source_of_truth")
  status                  PropertyStatus          @default(draft)
  archivedAt              DateTime?               @map("archived_at") @db.Timestamptz(6)
  setupVersion            Int                     @default(1) @map("setup_version")
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace               Workspace               @relation(fields: [workspaceId], references: [id])
  settings                PropertySetting[]
  integrations            IntegrationConnection[]
  connectorSyncRuns       ConnectorSyncRun[]
  dataSourceHealthRows    DataSourceHealth[]
  comparabilityWindows    ComparabilityWindow[]
  measurementAnnotations  MeasurementAnnotation[]
  pageGroups              PageGroup[]
  templates               Template[]
  canonicalPages          CanonicalPage[]
  urlRecords              UrlRecord[]
  pageMetricDailyRows     PageMetricDaily[]
  queryMetricDailyRows    QueryMetricDaily[]
  conversionDefinitions   ConversionDefinition[]
  releases                ReleaseAnnotation[]
  experiments             Experiment[]
  recommendations         Recommendation[]
  reports                 Report[]
  alerts                  Alert[]
  auditLogs               AuditLogEvent[]

  @@unique([workspaceId, primaryDomain])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("properties")
}

model PropertySetting {
  id                    String   @id @default(uuid())
  propertyId            String   @map("property_id")
  includeRulesJson      Json?    @map("include_rules_json")
  excludeRulesJson      Json?    @map("exclude_rules_json")
  taxonomySettingsJson  Json?    @map("taxonomy_settings_json")
  benchmarkSettingsJson Json?    @map("benchmark_settings_json")
  alertSettingsJson     Json?    @map("alert_settings_json")
  reportSettingsJson    Json?    @map("report_settings_json")
  trustPolicyJson       Json?    @map("trust_policy_json")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  property              Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId])
  @@map("property_settings")
}

model IntegrationConnection {
  id                 String              @id @default(uuid())
  workspaceId        String              @map("workspace_id")
  propertyId         String?             @map("property_id")
  provider           IntegrationProvider
  authType           IntegrationAuthType @default(oauth) @map("auth_type")
  status             IntegrationStatus   @default(syncing)
  credentialRef      String?             @map("credential_ref")
  configJson         Json?               @map("config_json")
  lastSyncedAt       DateTime?           @map("last_synced_at") @db.Timestamptz(6)
  lastSuccessAt      DateTime?           @map("last_success_at") @db.Timestamptz(6)
  lastErrorAt        DateTime?           @map("last_error_at") @db.Timestamptz(6)
  lastErrorMessage   String?             @map("last_error_message")
  freshnessSlaMinute Int?                @map("freshness_sla_minutes")
  createdByUserId    String?             @map("created_by_user_id")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property           Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdByUser      User?               @relation("IntegrationCreatedBy", fields: [createdByUserId], references: [id])
  healthChecks       DataSourceHealth[]
  syncRuns           ConnectorSyncRun[]
  searchConsoleSites SearchConsoleSite[]

  @@unique([workspaceId, propertyId, provider])
  @@index([workspaceId])
  @@index([propertyId])
  @@index([status])
  @@index([propertyId, provider])
  @@map("integration_connections")
}

model ConnectorCredential {
  id          String              @id @default(uuid())
  reference   String              @unique
  workspaceId String              @map("workspace_id")
  provider    IntegrationProvider
  payloadJson Json                @map("payload_json")
  metadataJson Json?              @map("metadata_json")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider])
  @@map("connector_credentials")
}

model ConnectorSyncRun {
  id                      String                   @id @default(uuid())
  integrationConnectionId String                   @map("integration_connection_id")
  workspaceId             String                   @map("workspace_id")
  propertyId              String?                  @map("property_id")
  provider                IntegrationProvider
  trigger                 ConnectorSyncRunTrigger
  status                  ConnectorSyncRunStatus
  partialFailure          Boolean                  @default(false) @map("partial_failure")
  startedAt               DateTime                 @map("started_at") @db.Timestamptz(6)
  finishedAt              DateTime?                @map("finished_at") @db.Timestamptz(6)
  freshnessMetadataJson   Json?                    @map("freshness_metadata_json")
  coverageMetadataJson    Json?                    @map("coverage_metadata_json")
  healthMetadataJson      Json?                    @map("health_metadata_json")
  errorMessage            String?                  @map("error_message")
  integrationConnection   IntegrationConnection    @relation(fields: [integrationConnectionId], references: [id], onDelete: Cascade)
  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property                Property?                @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  issues                  ConnectorSyncRunIssue[]

  @@index([integrationConnectionId, startedAt])
  @@index([workspaceId, startedAt])
  @@index([propertyId, startedAt])
  @@map("connector_sync_runs")
}

model ConnectorSyncRunIssue {
  id           String           @id @default(uuid())
  runId        String           @map("run_id")
  segment      String
  code         String
  message      String
  retryable    Boolean          @default(false)
  metadataJson Json?            @map("metadata_json")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  run          ConnectorSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, segment])
  @@map("connector_sync_run_issues")
}

model SearchConsoleSite {
  id                      String                @id @default(uuid())
  integrationConnectionId String                @map("integration_connection_id")
  workspaceId             String                @map("workspace_id")
  siteUrl                 String                @map("site_url")
  displayName             String                @map("display_name")
  permissionLevel         String?               @map("permission_level")
  selected                Boolean               @default(false)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  integrationConnection   IntegrationConnection @relation(fields: [integrationConnectionId], references: [id], onDelete: Cascade)
  workspace               Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([integrationConnectionId, siteUrl])
  @@index([workspaceId, integrationConnectionId])
  @@index([integrationConnectionId, selected])
  @@map("search_console_sites")
}

model DataSourceHealth {
  id                      String                 @id @default(uuid())
  propertyId              String                 @map("property_id")
  integrationConnectionId String                 @map("integration_connection_id")
  sourceName              String                 @map("source_name")
  healthStatus            DataSourceHealthStatus @default(healthy) @map("health_status")
  freshnessScore          Decimal?               @map("freshness_score") @db.Decimal(6, 3)
  coverageScore           Decimal?               @map("coverage_score") @db.Decimal(6, 3)
  reliabilityScore        Decimal?               @map("reliability_score") @db.Decimal(6, 3)
  issueCount              Int                    @default(0) @map("issue_count")
  measuredAt              DateTime               @map("measured_at") @db.Timestamptz(6)
  property                Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  integrationConnection   IntegrationConnection  @relation(fields: [integrationConnectionId], references: [id], onDelete: Cascade)

  @@index([propertyId, measuredAt])
  @@index([integrationConnectionId, measuredAt])
  @@map("data_source_health")
}

model ComparabilityWindow {
  id              String        @id @default(uuid())
  propertyId      String        @map("property_id")
  startDate       DateTime      @map("start_date") @db.Date
  endDate         DateTime      @map("end_date") @db.Date
  scopeType       DataScopeType @map("scope_type")
  scopeId         String?       @map("scope_id")
  reasonCode      String        @map("reason_code")
  notes           String?
  createdByUserId String?       @map("created_by_user_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdByUser   User?         @relation(fields: [createdByUserId], references: [id])

  @@index([propertyId, startDate, endDate])
  @@index([propertyId, scopeType, scopeId])
  @@map("comparability_windows")
}

model MeasurementAnnotation {
  id              String              @id @default(uuid())
  propertyId      String              @map("property_id")
  scopeType       AnnotationScopeType @map("scope_type")
  scopeId         String?             @map("scope_id")
  annotationType  AnnotationType      @map("annotation_type")
  title           String
  description     String
  severity        AnnotationSeverity
  activeFrom      DateTime            @map("active_from") @db.Timestamptz(6)
  activeTo        DateTime?           @map("active_to") @db.Timestamptz(6)
  createdByUserId String?             @map("created_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  property        Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdByUser   User?               @relation(fields: [createdByUserId], references: [id])

  @@index([propertyId, activeFrom, activeTo])
  @@index([propertyId, scopeType, scopeId])
  @@map("measurement_annotations")
}

model PageGroup {
  id          String          @id @default(uuid())
  propertyId  String          @map("property_id")
  name        String
  groupType   PageGroupType   @map("group_type")
  description String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  pages       CanonicalPage[]

  @@unique([propertyId, name])
  @@index([propertyId, groupType])
  @@map("page_groups")
}

model Template {
  id             String              @id @default(uuid())
  propertyId     String              @map("property_id")
  name           String
  templateFamily String?             @map("template_family")
  description    String?
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  property       Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  pages          CanonicalPage[]
  pageSnapshots  PageStateSnapshot[]

  @@unique([propertyId, name])
  @@index([propertyId, active])
  @@map("templates")
}

model CanonicalPage {
  id                 String                @id @default(uuid())
  propertyId         String                @map("property_id")
  canonicalUrl       String                @map("canonical_url")
  normalizedUrlKey   String                @map("normalized_url_key")
  title              String?
  metaTitle          String?               @map("meta_title")
  metaDescription    String?               @map("meta_description")
  h1                 String?
  templateId         String?               @map("template_id")
  pageGroupId        String?               @map("page_group_id")
  pageArchetype      String?               @map("page_archetype")
  contentType        String?               @map("content_type")
  funnelStage        String?               @map("funnel_stage")
  ownerTeam          String?               @map("owner_team")
  ownerUserId        String?               @map("owner_user_id")
  languageCode       String?               @map("language_code")
  regionCode         String?               @map("region_code")
  indexabilityStatus IndexabilityStatus    @default(indexable) @map("indexability_status")
  canonicalTargetUrl String?               @map("canonical_target_url")
  redirectTargetUrl  String?               @map("redirect_target_url")
  priorityTier       PriorityTier          @default(p2) @map("priority_tier")
  status             CanonicalPageStatus   @default(active)
  firstSeenAt        DateTime?             @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt         DateTime?             @map("last_seen_at") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  property           Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  template           Template?             @relation(fields: [templateId], references: [id], onDelete: SetNull)
  pageGroup          PageGroup?            @relation(fields: [pageGroupId], references: [id], onDelete: SetNull)
  ownerUser          User?                 @relation("CanonicalPageOwner", fields: [ownerUserId], references: [id])
  urlRecords         UrlRecord[]
  localizationRows   LocalizationVariant[]
  snapshots          PageStateSnapshot[]
  pageMetricDaily    PageMetricDaily[]
  queryMetricDaily   QueryMetricDaily[]

  @@unique([propertyId, normalizedUrlKey])
  @@index([propertyId, templateId])
  @@index([propertyId, pageGroupId])
  @@index([propertyId, status])
  @@map("canonical_pages")
}

model UrlRecord {
  id               String                @id @default(uuid())
  propertyId       String                @map("property_id")
  canonicalPageId  String                @map("canonical_page_id")
  rawUrl           String                @map("raw_url")
  normalizedUrlKey String                @map("normalized_url_key")
  isCurrentAlias   Boolean               @default(true) @map("is_current_alias")
  firstSeenAt      DateTime?             @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt       DateTime?             @map("last_seen_at") @db.Timestamptz(6)
  source           String?
  metadataJson     Json?                 @map("metadata_json")
  property         Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  canonicalPage    CanonicalPage         @relation(fields: [canonicalPageId], references: [id], onDelete: Cascade)
  localizationRows LocalizationVariant[]

  @@unique([propertyId, normalizedUrlKey])
  @@index([canonicalPageId])
  @@index([propertyId, isCurrentAlias])
  @@index([propertyId, canonicalPageId])
  @@map("url_records")
}

model LocalizationVariant {
  id              String        @id @default(uuid())
  canonicalPageId String        @map("canonical_page_id")
  localeCode      String        @map("locale_code")
  regionCode      String?       @map("region_code")
  urlRecordId     String        @map("url_record_id")
  isPrimary       Boolean       @default(false) @map("is_primary")
  canonicalPage   CanonicalPage @relation(fields: [canonicalPageId], references: [id], onDelete: Cascade)
  urlRecord       UrlRecord     @relation(fields: [urlRecordId], references: [id], onDelete: Cascade)

  @@unique([canonicalPageId, localeCode, regionCode])
  @@index([urlRecordId])
  @@map("localization_variants")
}

model PageStateSnapshot {
  id                 String        @id @default(uuid())
  canonicalPageId    String        @map("canonical_page_id")
  snapshotDate       DateTime      @map("snapshot_date") @db.Date
  title              String?
  metaTitle          String?       @map("meta_title")
  metaDescription    String?       @map("meta_description")
  h1                 String?
  templateId         String?       @map("template_id")
  contentHash        String?       @map("content_hash")
  indexabilityStatus String?       @map("indexability_status")
  internalLinkCount  Int?          @map("internal_link_count")
  crawlDepth         Int?          @map("crawl_depth")
  wordCount          Int?          @map("word_count")
  schemaJson         Json?         @map("schema_json")
  statusCode         Int?          @map("status_code")
  snapshotHtml       String?       @map("snapshot_html")
  fetchMode          String?       @map("fetch_mode")
  requestedUrl       String?       @map("requested_url")
  finalUrl           String?       @map("final_url")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  canonicalPage      CanonicalPage @relation(fields: [canonicalPageId], references: [id], onDelete: Cascade)
  template           Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([canonicalPageId, snapshotDate])
  @@index([snapshotDate])
  @@map("page_state_snapshots")
}

model PageMetricDaily {
  id                      String        @id @default(uuid())
  propertyId              String        @map("property_id")
  canonicalPageId         String        @map("canonical_page_id")
  date                    DateTime      @db.Date
  sessions                Decimal?      @db.Decimal(18, 4)
  users                   Decimal?      @db.Decimal(18, 4)
  entrances               Decimal?      @db.Decimal(18, 4)
  engagementRate          Decimal?      @map("engagement_rate") @db.Decimal(10, 6)
  avgEngagementSeconds    Decimal?      @map("avg_engagement_seconds") @db.Decimal(18, 4)
  ctaClicks               Decimal?      @map("cta_clicks") @db.Decimal(18, 4)
  formStarts              Decimal?      @map("form_starts") @db.Decimal(18, 4)
