model Recommendation {
  id                              String                          @id @default(uuid())
  propertyId                      String                          @map("property_id")
  recommendationType              RecommendationType              @default(investigate) @map("recommendation_type")
  domain                          RecommendationDomain            @default(technical)
  category                        String? // legacy compatibility
  relatedScopeType                RecommendationScopeType         @default(property) @map("related_scope_type")
  relatedScopeId                  String                          @map("related_scope_id")
  title                           String
  summary                         String?
  whyItMatters                    String?                         @map("why_it_matters")
  suggestedAction                 String?                         @map("suggested_action")
  evidenceJson                    Json?                           @map("evidence_json")
  sourceEvidenceJson              Json?                           @map("source_evidence_json") // legacy compatibility
  impactScore                     Decimal                         @default(0) @map("impact_score") @db.Decimal(10, 4)
  actionabilityScore              Decimal                         @default(0) @map("actionability_score") @db.Decimal(10, 4)
  trustScore                      Decimal                         @default(0) @map("trust_score") @db.Decimal(10, 6)
  confidenceScore                 Decimal                         @default(0) @map("confidence_score") @db.Decimal(10, 6)
  severity                        SeverityLevel                   @default(medium)
  estimatedEffort                 EffortSize?                     @map("estimated_effort")
  expectedTimeToImpactDays        Int?                            @map("expected_time_to_impact_days")
  reversibilityRisk               ReversibilityRisk?              @map("reversibility_risk")
  dependencyFlagsJson             Json?                           @map("dependency_flags_json")
  status                          RecommendationStatus            @default(new)
  archivedAt                      DateTime?                       @map("archived_at") @db.Timestamptz(6)
  ownerTeam                       String?                         @map("owner_team")
  ownerUserId                     String?                         @map("owner_user_id")
  dueDate                         DateTime?                       @map("due_date") @db.Date
  linkedTicketRef                 String?                         @map("linked_ticket_ref")
  approvalState                   ApprovalState                   @default(none) @map("approval_state")
  implementationVerificationState RecommendationVerificationState @default(not_started) @map("implementation_verification_state")
  generatedAt                     DateTime                        @default(now()) @map("generated_at") @db.Timestamptz(6)
  createdAt                       DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  property                        Property                        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerUser                       User?                           @relation("RecommendationOwner", fields: [ownerUserId], references: [id])

  @@index([propertyId, status])
  @@index([propertyId, status, dueDate])
  @@index([propertyId, severity])
  @@index([propertyId, domain])
  @@index([propertyId, relatedScopeType, relatedScopeId])
  @@map("recommendations")
}

model Report {
  id                String            @id @default(uuid())
  propertyId        String            @map("property_id")
  reportType        ReportType        @map("report_type")
