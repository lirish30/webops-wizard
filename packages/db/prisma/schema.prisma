generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String?
  fullName              String
  authProvider          AuthProvider           @default(local)
  status                UserStatus             @default(active)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  memberships           WorkspaceMembership[]
  ownedWorkspaces       Workspace[]            @relation("WorkspaceOwner")
  authSessions          AuthSession[]
  passwordResetTokens   PasswordResetToken[]
  sentWorkspaceInvites  WorkspaceInvite[]      @relation("WorkspaceInviteInviter")
  acceptedWorkspaceInvites WorkspaceInvite[]   @relation("WorkspaceInviteAcceptedUser")
  externalIdentityLinks ExternalIdentityLink[]
  authoredAuditEvents   AuditLogEvent[]        @relation("AuditActorUser")
}

model Workspace {
  id          String                @id @default(uuid())
  name        String
  slug        String                @unique
  ownerUserId String
  planTier    String                @default("starter")
  region      String                @default("us")
  status      WorkspaceStatus       @default(active)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  owner       User                  @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  memberships WorkspaceMembership[]
  invites     WorkspaceInvite[]
  properties  Property[]
  auditEvents AuditLogEvent[]
}

model WorkspaceMembership {
  id           String         @id @default(uuid())
  workspaceId  String
  userId       String
  role         MembershipRole
  lastActiveAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  workspace    Workspace      @relation(fields: [workspaceId], references: [id])
  user         User           @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
}

model AuthSession {
  id                 String    @id @default(uuid())
  userId             String
  refreshTokenHash   String
  activeWorkspaceId  String?
  userAgent          String?
  ipAddress          String?
  expiresAt          DateTime
  revokedAt          DateTime?
  lastUsedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model WorkspaceInvite {
  id             String         @id @default(uuid())
  workspaceId    String
  email          String
  role           MembershipRole
  inviterUserId  String
  tokenHash      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  workspace      Workspace      @relation(fields: [workspaceId], references: [id])
  inviter        User           @relation("WorkspaceInviteInviter", fields: [inviterUserId], references: [id])
  acceptedUser   User?          @relation("WorkspaceInviteAcceptedUser", fields: [acceptedUserId], references: [id])

  @@index([workspaceId, email])
  @@index([expiresAt])
}

model IdentityProvider {
  id          String               @id @default(uuid())
  type        IdentityProviderType @unique
  displayName String
  status      IdentityProviderStatus @default(coming_soon)
  configJson  Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  links       ExternalIdentityLink[]
}

model ExternalIdentityLink {
  id              String            @id @default(uuid())
  userId          String
  providerId      String
  providerSubject String
  emailSnapshot   String
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id])
  provider        IdentityProvider  @relation(fields: [providerId], references: [id])

  @@unique([providerId, providerSubject])
  @@index([userId])
}

model Property {
  id              String                  @id @default(uuid())
  workspaceId     String
  name            String
  primaryDomain   String
  environment     PropertyEnvironment     @default(production)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  workspace       Workspace               @relation(fields: [workspaceId], references: [id])
  integrations    IntegrationConnection[]
  recommendations Recommendation[]
  alerts          Alert[]
  releases        ReleaseAnnotation[]
}

model IntegrationConnection {
  id            String              @id @default(uuid())
  workspaceId   String
  propertyId    String?
  provider      IntegrationProvider
  status        IntegrationStatus   @default(syncing)
  lastSuccessAt DateTime?
  configJson    Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  property      Property?           @relation(fields: [propertyId], references: [id])
}

model Recommendation {
  id                 String   @id @default(uuid())
  propertyId         String
  title              String
  category           String
  status             String   @default("new")
  impactScore        Decimal  @default(0)
  confidenceScore    Decimal  @default(0)
  sourceEvidenceJson Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  property           Property @relation(fields: [propertyId], references: [id])
}

model Alert {
  id           String   @id @default(uuid())
  propertyId   String
  type         String
  severity     String
  status       String   @default("open")
  title        String
  body         String
  evidenceJson Json?
  triggeredAt  DateTime @default(now())
  property     Property @relation(fields: [propertyId], references: [id])
}

model ReleaseAnnotation {
  id          String   @id @default(uuid())
  propertyId  String
  eventType   String
  title       String
  description String?
  startedAt   DateTime
  createdAt   DateTime @default(now())
  property    Property @relation(fields: [propertyId], references: [id])
}

model AuditLogEvent {
  id          String             @id @default(uuid())
  workspaceId String
  actorUserId String?
  actorType   AuditActorType     @default(user)
  category    AuditEventCategory
  eventType   String
  targetType  String?
  targetId    String?
  metadataJson Json?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  occurredAt  DateTime           @default(now())
  createdAt   DateTime           @default(now())
  workspace   Workspace          @relation(fields: [workspaceId], references: [id])
  actorUser   User?              @relation("AuditActorUser", fields: [actorUserId], references: [id])

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, category])
  @@index([workspaceId, eventType])
  @@index([workspaceId, targetType, targetId])
  @@index([workspaceId, actorUserId])
}

enum AuthProvider {
  local
  google
  microsoft
}

enum UserStatus {
  active
  invited
  suspended
}

enum WorkspaceStatus {
  active
  suspended
}

enum MembershipRole {
  owner
  admin
  manager
  analyst
  viewer
  external_stakeholder
  agency_manager
  client_viewer
}

enum PropertyEnvironment {
  sandbox
  staging
  production
}

enum IntegrationProvider {
  ga4
  gsc
  sitemap
  crawler
}

enum IntegrationStatus {
  connected
  warning
  error
  syncing
}

enum IdentityProviderType {
  local
  google_oauth
  microsoft_oauth
  saml
}

enum IdentityProviderStatus {
  enabled
  disabled
  coming_soon
}

enum AuditActorType {
  user
  system
}

enum AuditEventCategory {
  membership
  integration
  report
  ai_generation
  approval
  settings
}
