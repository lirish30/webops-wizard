  requestId    String?             @map("request_id")
  ipAddress    String?             @map("ip_address")
  userAgent    String?             @map("user_agent")
  occurredAt   DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property     Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  actorUser    User?               @relation("AuditActorUser", fields: [actorUserId], references: [id])

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, category])
  @@index([workspaceId, eventType])
  @@index([workspaceId, targetType, targetId])
  @@index([workspaceId, actorUserId])
  @@index([workspaceId, requestId])
  @@index([propertyId, occurredAt])
  @@map("audit_logs")
}

