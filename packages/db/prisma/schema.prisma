model ConversionDefinition {
  id               String                        @id @default(uuid())
  propertyId       String                        @map("property_id")
  name             String
  conversionType   ConversionType                @map("conversion_type")
  status           ConversionDefinitionStatus    @default(draft)
  currentVersionId String?                       @unique @map("current_version_id")
  createdAt        DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  property         Property                      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  currentVersion   ConversionDefinitionVersion?  @relation("CurrentConversionDefinitionVersion", fields: [currentVersionId], references: [id])
  versions         ConversionDefinitionVersion[]

  @@unique([propertyId, name])
  @@index([propertyId, status])
  @@map("conversion_definitions")
}

model ConversionDefinitionVersion {
  id                     String                @id @default(uuid())
  conversionDefinitionId String                @map("conversion_definition_id")
  versionNumber          Int                   @map("version_number")
  eventName              String                @map("event_name")
  matchingRulesJson      Json?                 @map("matching_rules_json")
  externalFlowRulesJson  Json?                 @map("external_flow_rules_json")
  exclusionRulesJson     Json?                 @map("exclusion_rules_json")
  attributionNotes       String?               @map("attribution_notes")
  effectiveFrom          DateTime              @map("effective_from") @db.Timestamptz(6)
  effectiveTo            DateTime?             @map("effective_to") @db.Timestamptz(6)
  createdByUserId        String?               @map("created_by_user_id")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  conversionDefinition   ConversionDefinition  @relation(fields: [conversionDefinitionId], references: [id], onDelete: Cascade)
  createdByUser          User?                 @relation(fields: [createdByUserId], references: [id])
  currentForDefinition   ConversionDefinition? @relation("CurrentConversionDefinitionVersion")

  @@unique([conversionDefinitionId, versionNumber])
  @@index([effectiveFrom, effectiveTo])
  @@map("conversion_definition_versions")
}

