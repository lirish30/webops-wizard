  generatedByUser   User?             @relation("ReportGeneratedBy", fields: [generatedByUserId], references: [id])
  approvedByUser    User?             @relation("ReportApprovedBy", fields: [approvedByUserId], references: [id])

  @@index([propertyId, status])
  @@index([propertyId, reportType])
  @@index([sentAt])
  @@map("reports")
}

model Alert {
  id               String          @id @default(uuid())
  propertyId       String          @map("property_id")
  alertType        AlertType       @default(traffic_anomaly) @map("alert_type")
  type             String? // legacy compatibility
  relatedScopeType AlertScopeType? @map("related_scope_type")
  relatedScopeId   String?         @map("related_scope_id")
  severity         AlertSeverity
  title            String
  message          String
  body             String? // legacy compatibility
  evidenceJson     Json?           @map("evidence_json")
  confidenceScore  Decimal?        @map("confidence_score") @db.Decimal(10, 6)
  dedupeKey        String?         @map("dedupe_key")
  status           AlertStatus     @default(open)
  triggeredAt      DateTime        @default(now()) @map("triggered_at") @db.Timestamptz(6)
  resolvedAt       DateTime?       @map("resolved_at") @db.Timestamptz(6)
  property         Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([propertyId, status, triggeredAt])
  @@index([propertyId, severity])
  @@index([propertyId, triggeredAt])
  @@index([propertyId, dedupeKey])
  @@map("alerts")
}

model AuditLogEvent {
  id           String              @id @default(uuid())
  workspaceId  String              @map("workspace_id")
  propertyId   String?             @map("property_id")
  actorUserId  String?             @map("actor_user_id")
  actorType    AuditActorType      @default(user) @map("actor_type")
  actionType   String?             @map("action_type")
  category     AuditEventCategory?
  eventType    String              @map("event_type")
  targetType   String?             @map("target_type")
  targetId     String?             @map("target_id")
