{
  "name": "webops-wizard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "ci:install": "pnpm install --frozen-lockfile",
    "dev": "turbo run dev --parallel",
    "db:migration:check": "pnpm --filter @webops-wizard/db db:migration:check",
    "db:schema:validate": "pnpm --filter @webops-wizard/db db:schema:validate",
    "db:seed": "pnpm --filter @webops-wizard/db db:seed",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @webops-wizard/db db:generate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.14",
    "@eslint/js": "^9.23.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.23.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.28.0",
    "vitest": "^3.2.4"
  }
}
